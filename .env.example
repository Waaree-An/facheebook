# Copy this file to .env.local and fill in your real values.
#
# IMPORTANT: .env.local is gitignored and is the ONLY place real secrets belong.
# This template is tracked by git — never put a live API key in this file.
# The server loads `.env` (shared defaults) first, then `.env.local` (secrets win).

VITE_SUPABASE_URL=https://tfjheiyzphvjjgidwjyq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_sb_publishable_key_here
# Legacy projects may use VITE_SUPABASE_ANON_KEY instead; set only one key.

# Optional: enables real AI generation for /api/study-summary, /api/ai-generate-quiz
# and /api/ai-study-tip. Without this key the server returns a high-quality offline
# fallback instead of failing. Responses carry `source: "ai" | "fallback"` so you
# can tell which path served the request.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: model used for all AI generation. Defaults to gemini-3.8-flash.
# Verify the model your key can reach with: node scripts/probe-models.mjs
GEMINI_MODEL=gemini-3.8-flash

# Optional: comma-separated fallback models, tried in order when GEMINI_MODEL is
# out of quota or overloaded. Gemini enforces the free-tier request quota PER
# MODEL, so an exhausted model must not take the whole AI feature down.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional: how many times a transient upstream failure (503 "high demand") is
# retried on the same model before moving to the next model in the chain.
AI_MAX_ATTEMPTS=3

# Optional: per-attempt ceiling in milliseconds. One unresponsive model must not
# consume the whole request budget shared by the model chain.
AI_ATTEMPT_TIMEOUT_MS=20000

# Optional: total budget in milliseconds for one AI request across the chain.
AI_TIMEOUT_MS=120000

# Optional: HTTP port for the Express server (defaults to 3000).
PORT=3000

# Set to your public HTTPS origin after choosing a domain. Enables canonical
# landing-page URLs and an absolute sitemap.xml location.
PUBLIC_SITE_URL=

# Set to the hosted Express server origin when building Android, for example
# https://api.your-domain.example. Leave blank for same-origin web development.
VITE_API_BASE_URL=

# Additional exact browser origins allowed to call /api from another origin.
# Android's https://localhost and PUBLIC_SITE_URL are allowed automatically.
API_ALLOWED_ORIGINS=
